# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional: Exa web search for outside info (benchmarks, prices, rates). Set to 1 to enable.
COACH_WEB_SEARCH=0
EXA_API_KEY=

# PostgreSQL: local for development, or the Aiven Service URI
DATABASE_URL=postgresql://localhost:5432/coach
