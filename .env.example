# Copy to .env and fill in. Never commit .env.

# Optional demo date: the coach treats this as "today" and never shows data after it (data ends 2026-09-30)
COACH_TODAY=

# Which model the coach uses: "gemma" (Gemma 4 on Verda, the product) or "claude" (dev / comparison)
COACH_MODEL=gemma

# Gemma on Verda: base URL of the gemma-coach deployment (ends in /v1) and a Verda Inference API key
VERDA_BASE_URL=https://containers.datacrunch.io/gemma-coach/v1
VERDA_API_KEY=

# Claude: only needed with COACH_MODEL=claude
ANTHROPIC_API_KEY=

# PostgreSQL: the shared Aiven Service URI (or a local database)
DATABASE_URL=postgresql://localhost:5432/coach

# Optional: Exa web search for outside info (benchmarks, prices, rates). Set to 1 to enable.
COACH_WEB_SEARCH=0
EXA_API_KEY=
